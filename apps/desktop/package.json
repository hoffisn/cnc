{
  "name": "@rezets/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Rezets: a CNC machine control interface for the desktop",
  "author": "Rezets",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --win",
    "typecheck": "tsc -p tsconfig.node.json && vue-tsc -p tsconfig.web.json"
  },
  "dependencies": {
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "@rezets/core": "0.1.0",
    "@rezets/ui": "0.1.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "electron": "45.2.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "vite": "^8.3.5",
    "vue-tsc": "^3.3.14"
  },
  "build": {
    "appId": "app.rezets.desktop",
    "productName": "Rezets",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**"
    ],
    "asarUnpack": [
      "**/node_modules/@serialport/bindings-cpp/**"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
